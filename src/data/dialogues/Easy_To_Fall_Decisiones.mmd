%% ---------------------------------------------------------------------
%% FORMAS
%%   Rectángulo = escena o diálogo (sin decisión)
%%   Hexágono = decisión del jugador
%%   Rombo = condición automática (depende de variables de estado)
%%   Estadio (óvalo) = estado que se hereda al siguiente día
%%   Rectángulo de doble borde, oscuro = final
%% VARIABLES DE ESTADO
%%   PF  = puntos de familia (+PF suma, -PF resta)
%%   x3  = juega 3 juegos en el casino; x6 = juega 6 juegos (todo el día)
%%   N1, N2 = cómo terminó la noche de los días 1 y 2:
%%            A = x3 + tiempo con la familia | B = x3 + trabajó | C = x6
%%   N3 = A: x3 + vendió carro (esposa ya sabe) | B: x3 + conservó
%%        C: x6 + vendió carro (esposa no sabe) | D: x6 + conservó
%%   N5 = A: hipotecó la casa | B: usó ahorros de la hija | C: ninguna
%%   Los valores numéricos de PF y el cálculo del % de deuda dependen
%%   de las mecánicas del juego (no se definen en el guion).
%% ===================================================================== 

